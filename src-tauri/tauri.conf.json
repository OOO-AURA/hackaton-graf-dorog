{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Граф Дорог",
  "version": "0.1.0",
  "identifier": "ru.hackteam10.grafdorog",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Граф Дорог",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../tools/matsim-check/OsmCheck.java": "matsim-check/OsmCheck.java"
    },
    "windows": {
      "wix": {
        "language": "ru-RU"
      },
      "nsis": {
        "languages": [
          "Russian"
        ]
      }
    }
  }
}
